<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ВАЙБКУКОЛДИНГ — слоты для кодеров</title>
<style>
:root{
  --gold:#f5c542; --gold2:#ffdf80; --bg:#0b0614; --panel:#17102a;
  --purple:#7b2ff7; --pink:#f72f8b; --win:#4ade80;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  font-family:'Segoe UI',system-ui,sans-serif;color:#eee;overflow-x:hidden;
  background:
    radial-gradient(1200px 600px at 50% -10%, rgba(123,47,247,.35), transparent 60%),
    radial-gradient(900px 500px at 90% 110%, rgba(247,47,139,.18), transparent 60%),
    var(--bg);
  min-height:100vh;display:flex;flex-direction:column;align-items:center;
}
/* фоновые частицы */
.particle{position:fixed;border-radius:50%;pointer-events:none;z-index:0;opacity:.5;
  animation:floatUp linear infinite;}
@keyframes floatUp{from{transform:translateY(105vh)}to{transform:translateY(-10vh)}}

header{margin:26px 0 8px;text-align:center;z-index:2}
h1{
  font-size:clamp(28px,6vw,54px);letter-spacing:.12em;font-weight:900;
  background:linear-gradient(180deg,var(--gold2),var(--gold) 45%,#a97b12 80%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 0 22px rgba(245,197,66,.35));
  animation:titleGlow 3s ease-in-out infinite;
}
@keyframes titleGlow{0%,100%{filter:drop-shadow(0 0 14px rgba(245,197,66,.25))}50%{filter:drop-shadow(0 0 30px rgba(245,197,66,.55))}}
.subtitle{color:#b9a8e8;font-size:13px;letter-spacing:.35em;text-transform:uppercase;margin-top:6px}

.panel{
  z-index:2;background:linear-gradient(160deg,rgba(35,22,64,.9),rgba(20,12,38,.95));
  border:1px solid rgba(245,197,66,.25);border-radius:20px;
  box-shadow:0 20px 60px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.06);
  padding:18px;backdrop-filter:blur(8px);
}
.stats{display:flex;gap:26px;flex-wrap:wrap;justify-content:center;margin:18px 0 4px;font-size:14px}
.stats b{color:var(--gold);font-size:18px;font-variant-numeric:tabular-nums}
.stats span{color:#9d8cc9}

/* ==== СЛОТ ==== */
.machine{margin-top:14px;width:min(560px,94vw)}
.reels{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.reel{
  height:clamp(110px,22vw,150px);overflow:hidden;position:relative;border-radius:14px;
  background:linear-gradient(180deg,#0e081d,#1a1033 50%,#0e081d);
  border:1px solid rgba(123,47,247,.35);
  box-shadow:inset 0 10px 18px rgba(0,0,0,.65), inset 0 -10px 18px rgba(0,0,0,.65);
}
.reel::before,.reel::after{content:'';position:absolute;left:0;right:0;height:34px;z-index:3;pointer-events:none}
.reel::before{top:0;background:linear-gradient(180deg,rgba(6,3,14,.9),transparent)}
.reel::after{bottom:0;background:linear-gradient(0deg,rgba(6,3,14,.9),transparent)}
.strip{position:absolute;left:0;right:0;top:0;will-change:transform}
.cell{height:clamp(110px,22vw,150px);display:flex;align-items:center;justify-content:center}
.cell svg{width:64%;height:64%;filter:drop-shadow(0 4px 10px rgba(0,0,0,.5));transition:transform .3s}
.cell.winner svg{animation:symPop .55s cubic-bezier(.34,1.56,.64,1)}
@keyframes symPop{0%{transform:scale(1)}40%{transform:scale(1.3) rotate(-6deg)}100%{transform:scale(1)}}

.controls{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px;flex-wrap:wrap}
.betbox{display:flex;align-items:center;gap:8px}
.betbox button{
  width:38px;height:38px;border-radius:50%;border:1px solid rgba(245,197,66,.4);
  background:rgba(245,197,66,.1);color:var(--gold);font-size:20px;cursor:pointer;transition:.2s;
}
.betbox button:hover{background:rgba(245,197,66,.3);transform:scale(1.1)}
.betval{min-width:76px;text-align:center;font-weight:800;font-size:18px;color:var(--gold);font-variant-numeric:tabular-nums}

#spinBtn{
  position:relative;flex:1;min-width:170px;padding:15px 22px;border:none;border-radius:16px;cursor:pointer;
  font-size:19px;font-weight:900;letter-spacing:.18em;color:#241500;text-transform:uppercase;
  background:linear-gradient(180deg,var(--gold2),var(--gold) 55%,#d9a520);
  box-shadow:0 8px 24px rgba(245,197,66,.35), inset 0 2px 0 rgba(255,255,255,.6);
  transition:transform .15s, box-shadow .2s;overflow:hidden;
}
#spinBtn:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 12px 32px rgba(245,197,66,.5)}
#spinBtn:active:not(:disabled){transform:translateY(1px) scale(.98)}
#spinBtn:disabled{filter:grayscale(.6) brightness(.7);cursor:wait}
#spinBtn::after{content:'';position:absolute;top:0;left:-80%;width:50%;height:100%;
  background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);
  animation:shine 2.8s ease-in-out infinite;}
@keyframes shine{0%{left:-80%}55%,100%{left:130%}}

.message{min-height:26px;text-align:center;margin-top:14px;font-size:17px;font-weight:700;letter-spacing:.05em;
  color:#cfc2f2;transition:opacity .3s}
.message.win{color:var(--win);text-shadow:0 0 18px rgba(74,222,128,.6)}
.message.bonus{color:var(--gold);text-shadow:0 0 22px rgba(245,197,66,.8);animation:pulseTxt 1s ease-in-out infinite}
@keyframes pulseTxt{50%{transform:scale(1.06)}}

.paytable{margin:22px 0 10px;width:min(560px,94vw)}
.paytable h3{color:var(--gold);letter-spacing:.2em;font-size:13px;text-transform:uppercase;margin-bottom:10px;text-align:center}
.pt-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.pt-item{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.04);
  border-radius:10px;padding:6px 10px;font-size:13px}
.pt-item svg{width:30px;height:30px;flex:none}
.pt-item b{color:var(--gold);margin-left:auto}
footer{margin:18px 0 26px;color:#6b5b96;font-size:12px;text-align:center;z-index:2;line-height:1.6}

/* ==== БОНУСКА ==== */
#bonusOverlay{
  position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;
  background:radial-gradient(ellipse at center,rgba(30,10,60,.92),rgba(5,2,12,.97));
  opacity:0;transition:opacity .8s ease;
}
#bonusOverlay.show{display:flex}
#bonusOverlay.visible{opacity:1}
.bonus-stage{position:relative;text-align:center;width:min(640px,94vw)}

/* бог */
#godWrap{width:min(320px,60vw);margin:0 auto;transform:scale(0);opacity:0}
#godWrap.enter{animation:godIn 2.2s cubic-bezier(.22,1,.36,1) forwards}
@keyframes godIn{
  0%{transform:scale(0) translateY(80px) rotate(-8deg);opacity:0;filter:blur(10px)}
  55%{transform:scale(1.12) translateY(-8px) rotate(2deg);opacity:1;filter:blur(0)}
  75%{transform:scale(.96) translateY(2px) rotate(-1deg)}
  100%{transform:scale(1) translateY(0) rotate(0);opacity:1}
}
#godWrap svg{width:100%;overflow:visible}
#godBody{transform-origin:160px 130px}
#godWrap.talking #godBody{animation:godTalk .5s ease-in-out infinite}
@keyframes godTalk{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
#godWrap.winPulse #godBody{animation:godWin .6s cubic-bezier(.34,1.56,.64,1)}
@keyframes godWin{0%{transform:scale(1)}40%{transform:scale(1.08)}100%{transform:scale(1)}}
.bolt{opacity:0}
.bolt.flash{animation:boltFlash .5s ease-out}
@keyframes boltFlash{0%{opacity:0}15%{opacity:1}100%{opacity:0}}
#boltArm{transform-origin:205px 120px}
#boltArm.throw{animation:throwBolt .7s ease-in}
@keyframes throwBolt{0%{transform:rotate(0)}35%{transform:rotate(-32deg)}100%{transform:rotate(0)}}
#thrownBolt{opacity:0}
#thrownBolt.fly{animation:boltFly .7s ease-in}
@keyframes boltFly{0%{opacity:1;transform:translate(0,0) scale(1)}100%{opacity:0;transform:translate(-140px,240px) scale(1.6)}}

.bonus-title{
  font-size:clamp(24px,5vw,40px);font-weight:900;letter-spacing:.14em;margin-top:8px;
  background:linear-gradient(180deg,#fff,var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent;
  text-shadow:0 0 40px rgba(245,197,66,.4);
}
.bonus-sub{color:#c9b8f5;margin:6px 0 14px;font-size:15px}
.bonus-info{display:flex;justify-content:center;gap:30px;margin-bottom:16px;font-size:15px}
.bonus-info b{color:var(--gold);font-size:20px;font-variant-numeric:tabular-nums}
.bonus-reels-wrap{
  background:rgba(255,255,255,.04);border:1px solid rgba(245,197,66,.3);
  border-radius:18px;padding:14px;
}
#bonusSpinBtn{
  margin-top:16px;padding:13px 40px;border:none;border-radius:14px;cursor:pointer;
  font-size:16px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;color:#241500;
  background:linear-gradient(180deg,var(--gold2),var(--gold) 55%,#d9a520);
  box-shadow:0 8px 24px rgba(245,197,66,.35);transition:transform .15s;
}
#bonusSpinBtn:hover:not(:disabled){transform:translateY(-2px) scale(1.03)}
#bonusSpinBtn:disabled{filter:grayscale(.6) brightness(.7);cursor:wait}
#collectBtn{
  margin-top:12px;display:none;padding:13px 40px;border-radius:14px;cursor:pointer;
  font-size:16px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;
  color:#fff;background:linear-gradient(180deg,var(--pink),#c2176b);border:none;
  box-shadow:0 8px 24px rgba(247,47,139,.4);transition:transform .15s;
}
#collectBtn:hover{transform:translateY(-2px) scale(1.03)}
#bonusMsg{min-height:24px;margin-top:12px;font-weight:700;color:var(--win)}
#flash{position:fixed;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:60}
#flash.on{animation:flashA .45s ease-out}
@keyframes flashA{0%{opacity:.85}100%{opacity:0}}
.lightning-bg{position:absolute;inset:0;pointer-events:none;overflow:hidden}
@media (max-width:480px){.pt-grid{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div id="flash"></div>

<header>
  <h1>ВАЙБКУКОЛДИНГ</h1>
  <div class="subtitle">слот-машина для кодеров · RTP 96%</div>
</header>

<div class="stats">
  <div><span>Баланс</span><br><b id="balance">1000</b></div>
  <div><span>Выигрыш</span><br><b id="lastWin">0</b></div>
  <div><span>Ставка</span><br><b id="betView">10</b></div>
</div>

<div class="machine panel">
  <div class="reels" id="reels"></div>
  <div class="message" id="message">Жми SPIN и лови вайб</div>
  <div class="controls">
    <div class="betbox">
      <button id="betMinus" aria-label="минус">−</button>
      <div class="betval" id="betVal">10</div>
      <button id="betPlus" aria-label="плюс">+</button>
    </div>
    <button id="spinBtn">Spin</button>
  </div>
</div>

<div class="paytable panel">
  <h3>Выплаты ×3 в ряд (от ставки)</h3>
  <div class="pt-grid" id="ptGrid"></div>
</div>

<footer>
  Демо-игра, виртуальные кредиты · без реальных денег<br>
  3 эмблемы РУТ(МИИТ) = бонуска с Греческим богом
</footer>

<!-- ==================== БОНУСКА ==================== -->
<div id="bonusOverlay">
  <div class="lightning-bg" id="lightningBg"></div>
  <div class="bonus-stage">
    <div id="godWrap">
      <svg viewBox="0 0 320 340" id="godSvg">
        <defs>
          <linearGradient id="togaG" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#cfc4e8"/>
          </linearGradient>
          <linearGradient id="skinG" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f0c8a0"/><stop offset="1" stop-color="#d9a06e"/>
          </linearGradient>
          <radialGradient id="haloG" cx=".5" cy=".5" r=".5">
            <stop offset="0" stop-color="#f5c542" stop-opacity=".55"/>
            <stop offset="1" stop-color="#f5c542" stop-opacity="0"/>
          </radialGradient>
          <filter id="glowF"><feGaussianBlur stdDeviation="3.5" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <circle cx="160" cy="105" r="92" fill="url(#haloG)"/>
        <!-- молнии вокруг -->
        <g filter="url(#glowF)" stroke="#ffe066" stroke-width="5" fill="none" stroke-linejoin="round">
          <path class="bolt" id="bolt1" d="M60 30 L45 70 L62 70 L48 115"/>
          <path class="bolt" id="bolt2" d="M262 40 L246 82 L264 82 L248 128"/>
          <path class="bolt" id="bolt3" d="M30 150 L18 185 L33 185 L20 222"/>
          <path class="bolt" id="bolt4" d="M292 155 L280 190 L295 190 L282 226"/>
        </g>
        <g id="godBody">
          <!-- рука с молнией (правая) -->
          <g id="boltArm">
            <path d="M205 120 Q245 105 262 70" stroke="url(#skinG)" stroke-width="20" fill="none" stroke-linecap="round"/>
            <circle cx="264" cy="66" r="13" fill="url(#skinG)"/>
            <path d="M268 40 L252 72 L266 72 L254 104 L282 62 L266 62 L276 40 Z"
                  fill="#ffe066" filter="url(#glowF)" id="heldBolt"/>
          </g>
          <!-- левая рука -->
          <path d="M115 120 Q78 108 62 78" stroke="url(#skinG)" stroke-width="20" fill="none" stroke-linecap="round"/>
          <circle cx="60" cy="74" r="13" fill="url(#skinG)"/>
          <!-- торс в тоге -->
          <path d="M118 115 Q160 98 202 115 L212 190 Q160 210 108 190 Z" fill="url(#skinG)"/>
          <path d="M108 122 Q160 100 212 122 L222 210 Q160 235 98 210 Z" fill="url(#togaG)"/>
          <path d="M108 122 Q150 138 200 120 L206 150 Q155 168 112 150 Z" fill="#b9a8e0" opacity=".55"/>
          <path d="M130 118 L126 205 M160 112 L160 212 M190 118 L194 205" stroke="#9d8cc9" stroke-width="3" opacity=".5"/>
          <!-- пояс -->
          <rect x="100" y="196" width="120" height="14" rx="7" fill="#f5c542"/>
          <!-- голова = эмблема -->
          <g id="godHead" transform="translate(160,58)"></g>
        </g>
        <path id="thrownBolt" d="M264 40 L248 72 L262 72 L250 104 L278 62 L262 62 L272 40 Z"
              fill="#fff" filter="url(#glowF)"/>
      </svg>
    </div>
    <div class="bonus-title">БОНУСКА РУТ(МИИТ)</div>
    <div class="bonus-sub">Греческий бог дарует фриспины · все выигрыши ×3</div>
    <div class="bonus-info">
      <div>Фриспины<br><b id="freeSpins">10</b></div>
      <div>Выигрыш бонуски<br><b id="bonusWin">0</b></div>
    </div>
    <div class="bonus-reels-wrap"><div class="reels" id="bonusReels"></div></div>
    <div><button id="bonusSpinBtn">Фриспин</button></div>
    <div><button id="collectBtn">Забрать</button></div>
    <div id="bonusMsg"></div>
  </div>
</div>

<script>
/* ================= СИМВОЛЫ (SVG) ================= */
const ICONS = {
claude:`<svg viewBox="0 0 64 64"><g fill="#d97757">
<rect x="26" y="6" width="12" height="52" rx="6"/>
<rect x="26" y="6" width="12" height="52" rx="6" transform="rotate(30 32 32)"/>
<rect x="26" y="6" width="12" height="52" rx="6" transform="rotate(60 32 32)"/>
<rect x="26" y="6" width="12" height="52" rx="6" transform="rotate(90 32 32)"/>
<rect x="26" y="6" width="12" height="52" rx="6" transform="rotate(120 32 32)"/>
<rect x="26" y="6" width="12" height="52" rx="6" transform="rotate(150 32 32)"/></g></svg>`,
cursor:`<svg viewBox="0 0 64 64"><rect x="4" y="4" width="56" height="56" rx="14" fill="#111"/>
<path d="M22 16 L46 32 L34 35 L40 48 L33 51 L27 38 L20 44 Z" fill="#fff"/></svg>`,
chatgpt:`<svg viewBox="0 0 64 64"><g fill="none" stroke="#10a37f" stroke-width="4.5" stroke-linecap="round">
<path d="M32 8 Q50 8 50 26 Q50 40 32 40 Q20 40 20 26 Q20 14 32 14 Q44 14 44 28 Q44 38 32 38"/>
<path d="M32 40 Q32 56 16 56 Q8 56 8 46 Q8 36 20 36 Q28 36 30 44"/>
<path d="M32 40 Q40 52 50 48 Q58 45 55 37 Q52 30 44 33"/></g></svg>`,
yandex:`<svg viewBox="0 0 64 64"><defs><linearGradient id="yag" x1="0" y1="0" x2="1" y2="1">
<stop offset="0" stop-color="#ff1f1f"/><stop offset="1" stop-color="#b3001f"/></linearGradient></defs>
<circle cx="32" cy="32" r="28" fill="url(#yag)"/>
<text x="32" y="42" text-anchor="middle" font-size="26" font-weight="900" fill="#fff" font-family="Arial">Я</text></svg>`,
kimi:`<svg viewBox="0 0 64 64"><defs><linearGradient id="kg" x1="0" y1="0" x2="1" y2="1">
<stop offset="0" stop-color="#3b82f6"/><stop offset="1" stop-color="#1e3a8a"/></linearGradient></defs>
<circle cx="32" cy="32" r="28" fill="url(#kg)"/>
<path d="M40 12 A24 24 0 1 0 52 32 A19 19 0 1 1 40 12 Z" fill="#dbeafe" opacity=".9"/>
<circle cx="24" cy="32" r="4" fill="#fff"/></svg>`,
rut:`<svg viewBox="0 0 64 64"><defs>
<radialGradient id="rg" cx=".5" cy=".4" r=".7">
<stop offset="0" stop-color="#2a1b52"/><stop offset="1" stop-color="#120a26"/></radialGradient></defs>
<circle cx="32" cy="32" r="30" fill="url(#rg)" stroke="#f5c542" stroke-width="3"/>
<circle cx="32" cy="32" r="25" fill="none" stroke="#f5c542" stroke-width="1" opacity=".5"/>
<path d="M20 22 V40 M27 22 V40 M20 31 H27 M37 22 V40 M44 22 V40 M37 31 H44" stroke="#f5c542" stroke-width="2.6" fill="none" stroke-linecap="round"/>
<path d="M18 44 Q32 52 46 44" stroke="#f5c542" stroke-width="2" fill="none"/>
<path d="M32 12 l2.2 3.4 -2.2 3.4 -2.2 -3.4 Z" fill="#f5c542"/>
<path d="M12 32 l3.4 -2.2 3.4 2.2 -3.4 2.2 Z M45 32 l3.4 -2.2 3.4 2.2 -3.4 2.2 Z" fill="#f5c542" opacity=".8"/></svg>`
};

/* голова бога = эмблема, крупная */
const GOD_HEAD = ICONS.rut.replace('viewBox="0 0 64 64"','viewBox="0 0 64 64" x="-46" y="-46" width="92" height="92"');

/* ================= КОНФИГ ================= */
const SYMBOLS = ['claude','cursor','chatgpt','yandex','kimi','rut'];
const WEIGHTS = {claude:.22,cursor:.20,chatgpt:.20,yandex:.18,kimi:.15,rut:.05};
const PAYS    = {claude:12,cursor:10,chatgpt:7,yandex:6,kimi:5,rut:0};
const BONUS_MULT = 3, FREE_SPINS = 10;
const LINES = [[0,1,2],[3,4,5],[6,7,8]]; // индексы ячеек 3x3

let balance = 1000, bet = 10, spinning = false;

/* ================= DOM ================= */
const $ = id => document.getElementById(id);
const reelsEl = $('reels'), bonusReelsEl = $('bonusReels');
const messageEl = $('message'), spinBtn = $('spinBtn');

function buildReels(container, count){
  const strips = [];
  for(let r=0;r<count;r++){
    const reel = document.createElement('div'); reel.className='reel';
    const strip = document.createElement('div'); strip.className='strip';
    for(let i=0;i<18;i++){
      const c = document.createElement('div'); c.className='cell';
      c.innerHTML = ICONS[SYMBOLS[i%SYMBOLS.length]];
      strip.appendChild(c);
    }
    reel.appendChild(strip); container.appendChild(reel); strips.push(strip);
  }
  return strips;
}
const strips = buildReels(reelsEl,3);
const bonusStrips = buildReels(bonusReelsEl,3);

/* выплаты таблица */
const pt = $('ptGrid');
SYMBOLS.forEach(s=>{
  const d=document.createElement('div'); d.className='pt-item';
  d.innerHTML = ICONS[s] + `<span>${s==='rut'?'БОНУСКА':'×'+PAYS[s]}</span>`;
  pt.appendChild(d);
});

/* голова бога */
$('godHead').innerHTML = GOD_HEAD;

/* частицы фона */
for(let i=0;i<26;i++){
  const p=document.createElement('div'); p.className='particle';
  const s=2+Math.random()*4;
  p.style.cssText=`width:${s}px;height:${s}px;left:${Math.random()*100}vw;
    background:${Math.random()>.5?'#f5c542':'#7b2ff7'};
    animation-duration:${9+Math.random()*14}s;animation-delay:-${Math.random()*20}s`;
  document.body.appendChild(p);
}

/* ================= ЛОГИКА ================= */
function weightedPick(){
  let r = Math.random(), acc = 0;
  for(const s of SYMBOLS){ acc += WEIGHTS[s]; if(r <= acc) return s; }
  return 'claude';
}
function spinSymbols(){ return Array.from({length:9}, weightedPick); }

function evalBoard(board, mult=1){
  let win = 0; const winCells = new Set();
  for(const line of LINES){
    const [a,b,c] = line;
    if(board[a]===board[b] && board[b]===board[c]){
      const s = board[a];
      if(PAYS[s]>0){ win += bet*PAYS[s]*mult; line.forEach(i=>winCells.add(i)); }
    }
  }
  return {win, winCells};
}

function updateStats(){
  $('balance').textContent = balance;
  $('betView').textContent = bet;
  $('betVal').textContent = bet;
  $('lastWin').textContent = $('lastWin').textContent;
}
function showMessage(txt, cls=''){
  messageEl.textContent = txt;
  messageEl.className = 'message ' + cls;
}
function animateNumber(el, to, dur=600){
  const from = parseInt(el.textContent)||0, t0 = performance.now();
  function step(t){
    const k = Math.min(1,(t-t0)/dur);
    el.textContent = Math.round(from + (to-from)*(1-Math.pow(1-k,3)));
    if(k<1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function spinStrip(strip, finalSyms, duration){
  return new Promise(res=>{
    const H = strip.children[0].offsetHeight;
    const total = 18*H;
    // ставим финальные символы в последние 3 ячейки (середина окна = ячейки 15,16,17)
    for(let i=0;i<3;i++) strip.children[15+i].innerHTML = ICONS[finalSyms[i]];
    const target = total*Math.ceil(duration/900) - 3*H; // крутим + останавливаемся на 15-й
    strip.style.transition = 'none';
    strip.style.transform = 'translateY(0)';
    strip.offsetHeight; // reflow
    strip.style.transition = `transform ${duration}ms cubic-bezier(.15,.85,.25,1)`;
    strip.style.transform = `translateY(${-target}px)`;
    setTimeout(res, duration+60);
  });
}

async function spin(){
  if(spinning) return;
  if(balance < bet){ showMessage('Не хватает кредитов — перезагрузи страницу','bonus'); return; }
  spinning = true; spinBtn.disabled = true;
  balance -= bet; updateStats();
  showMessage('');

  const board = spinSymbols();
  const cols = [[board[0],board[3],board[6]],[board[1],board[4],board[7]],[board[2],board[5],board[8]]];

  await Promise.all(strips.map((s,i)=>spinStrip(s, cols[i], 900+i*550)));

  const rutCount = board.filter(s=>s==='rut').length;
  if(rutCount>=3){
    showMessage('БОНУСКА РУТ(МИИТ)!','bonus');
    setTimeout(()=>startBonus(), 1200);
  } else {
    const {win, winCells} = evalBoard(board);
    if(win>0){
      balance += win; animateNumber($('lastWin'), win);
      showMessage(`+${win} кредитов! Вайб пойман`,'win');
      winCells.forEach(i=>{
        const reel = Math.floor(i%3), row = Math.floor(i/3);
        strips[reel].children[15+row].classList.add('winner');
      });
    } else {
      showMessage(['Почти! Код не задеплоился','Спинь ещё, вайб близко','Мердж-конфликт с удачей'][Math.floor(Math.random()*3)]);
    }
    updateStats();
  }
  spinning = false; spinBtn.disabled = false;
}

/* ставки */
$('betMinus').onclick = ()=>{ bet = Math.max(1, bet- (bet>100?50:bet>20?10:1)); updateStats(); };
$('betPlus').onclick  = ()=>{ bet = Math.min(500, bet+(bet>=100?50:bet>=20?10:1)); updateStats(); };
spinBtn.onclick = spin;

/* ================= БОНУСКА ================= */
const overlay = $('bonusOverlay'), godWrap = $('godWrap');
let bonusSpinsLeft = 0, bonusTotal = 0, bonusBusy = false;

function lightningStrike(big=false){
  const flash = $('flash');
  flash.classList.remove('on'); flash.offsetHeight; flash.classList.add('on');
  // случайная молния фоном
  const bolts = ['bolt1','bolt2','bolt3','bolt4'];
  const b = $(bolts[Math.floor(Math.random()*bolts.length)]);
  b.classList.remove('flash'); b.offsetHeight;
  b.style.animationDuration = (big?'.8s':'.5s'); b.classList.add('flash');
  // бросок молнии
  const arm = $('boltArm'), thrown = $('thrownBolt');
  arm.classList.remove('throw'); arm.offsetHeight; arm.classList.add('throw');
  thrown.classList.remove('fly'); thrown.offsetHeight; thrown.classList.add('fly');
  godWrap.classList.add('talking');
  setTimeout(()=>godWrap.classList.remove('talking'), 1200);
}

async function startBonus(){
  bonusSpinsLeft = FREE_SPINS; bonusTotal = 0; bonusBusy = false;
  $('freeSpins').textContent = bonusSpinsLeft;
  $('bonusWin').textContent = '0';
  $('bonusMsg').textContent = '';
  $('bonusSpinBtn').style.display = '';
  $('collectBtn').style.display = 'none';

  overlay.classList.add('show');
  requestAnimationFrame(()=>requestAnimationFrame(()=>overlay.classList.add('visible')));
  godWrap.classList.remove('enter'); godWrap.offsetHeight;
  godWrap.classList.add('enter');

  // залп молний при появлении бога
  [0,350,700,1100].forEach(t=>setTimeout(()=>lightningStrike(t===0),t));

  $('bonusSpinBtn').onclick = bonusSpin;
  $('collectBtn').onclick = endBonus;
}

async function bonusSpin(){
  if(bonusBusy || bonusSpinsLeft<=0) return;
  bonusBusy = true;
  $('bonusSpinBtn').disabled = true;
  $('bonusMsg').textContent = '';
  bonusSpinsLeft--;
  $('freeSpins').textContent = bonusSpinsLeft;

  const board = spinSymbols();
  const cols = [[board[0],board[3],board[6]],[board[1],board[4],board[7]],[board[2],board[5],board[8]]];
  await Promise.all(bonusStrips.map((s,i)=>spinStrip(s, cols[i], 800+i*450)));

  const {win, winCells} = evalBoard(board, BONUS_MULT);
  if(win>0){
    bonusTotal += win;
    animateNumber($('bonusWin'), bonusTotal);
    $('bonusMsg').textContent = `+${win}!`;
    lightningStrike(true);
    godWrap.classList.remove('winPulse'); godWrap.offsetHeight; godWrap.classList.add('winPulse');
    winCells.forEach(i=>{
      const reel = Math.floor(i%3), row = Math.floor(i/3);
      bonusStrips[reel].children[15+row].classList.add('winner');
    });
    setTimeout(()=>bonusStrips.forEach(s=>[...s.children].forEach(c=>c.classList.remove('winner'))), 1500);
  }

  bonusBusy = false;
  if(bonusSpinsLeft<=0){
    $('bonusSpinBtn').style.display = 'none';
    $('bonusMsg').textContent = `Бонуска завершена! Итого +${bonusTotal}`;
    $('collectBtn').style.display = 'inline-block';
  } else {
    $('bonusSpinBtn').disabled = false;
  }
}

function endBonus(){
  overlay.classList.remove('visible');
  setTimeout(()=>{
    overlay.classList.remove('show');
    balance += bonusTotal;
    animateNumber($('balance'), balance);
    animateNumber($('lastWin'), bonusTotal);
    showMessage(`Бонуска принесла +${bonusTotal} кредитов!`,'win');
  }, 800);
}

updateStats();
</script>
